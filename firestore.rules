rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS & SAFEGUARDS
    // ========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Checks that the user is not blocked by an Admin
    function isActiveUser() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'approved') != 'blocked'
      );
    }

    // ========================================================================
    // 1. ADMINS COLLECTION (/admins/{uid})
    // ========================================================================
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================================================
    // 2. USERS & PERSONAL MEAL PLANS (/users/{userId})
    //    - Users can read/write their own meal plan (if not blocked)
    //    - Users cannot change their own 'status' to bypass blocks
    //    - Admins can read all users, approve/block users, and push meal plans
    // ========================================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
          request.resource.data.get('status', 'approved') == 'approved')
      );

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        isActiveUser() &&
        request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved')
      );

      allow delete: if isAdmin();
    }

    // ========================================================================
    // 3. GLOBAL PUBLIC RECIPES (/globalRecipes/{recipeId})
    //    - Anyone can read approved global recipes
    //    - Only Admins can create, update, or delete global recipes
    // ========================================================================
    match /globalRecipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // 4. COMMUNITY RECIPE SUBMISSIONS (/recipeSubmissions/{subId})
    //    - Active users can submit a recipe with status == 'pending'
    //    - Users can edit/delete their own pending submissions
    //    - Admins can approve, reject, edit, or delete any submission
    // ========================================================================
    match /recipeSubmissions/{subId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.authorId == request.auth.uid
      );

      allow create: if isActiveUser() && (
        isAdmin() || (
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.status == 'pending'
        )
      );

      allow update: if isAdmin() || (
        isActiveUser() &&
        resource.data.authorId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );

      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.authorId == request.auth.uid &&
        resource.data.status == 'pending'
      );
    }

    // ========================================================================
    // 5. OFFICIAL TEMPLATE MEAL PLANS (/officialPlans/{planId})
    //    - Anyone can read Official Template Meal Plans
    //    - Only Admins can publish, update, or delete Official Templates
    // ========================================================================
    match /officialPlans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
